# Copy to .env and fill in.
SHAREDESK_SSH_HOST=192.168.1.10
SHAREDESK_SSH_USER=sharedesk
SHAREDESK_ADMIN_PASSWORD=change-me
# Optional: keep sessions across restarts (any long random string).
SHAREDESK_SECRET=
SHAREDESK_SHARE_ROOT=/mnt/shares
SHAREDESK_DEFAULT_GROUP=sambashare
# Users the UI won't disable or remove (root and the SSH user are always protected).
SHAREDESK_PROTECTED_USERS=
# Set to 1 if you put ShareDesk behind HTTPS.
SHAREDESK_SECURE_COOKIE=
SHAREDESK_PORT=8080
